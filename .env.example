# Copy this file to .env and adjust for your machine:  cp .env.example .env
# All values below are safe local-development defaults.

# --- Database (local PostgreSQL) ---
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/realtime_messaging?schema=public"

# --- Auth ---
# 32+ character secret for signing session JWTs. Generate a real one for any deployment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET="dev-only-secret-change-me-please-32chars-min-000"
AUTH_COOKIE="rtm_session"

# --- Server ---
PORT=3000
HOSTNAME=localhost
APP_ORIGIN="http://localhost:3000"

# --- GIPHY ---
# Works out of the box with GIPHY's public SDK demo key below.
# For anything beyond local testing, create a free key at developers.giphy.com.
GIPHY_API_KEY="GlVGYHkr3WSBnllca54iNt0yFbjz7L65"

# --- Uploads / moderation ---
STORAGE_DIR="./storage"
MAX_UPLOAD_BYTES=8388608
NSFW_MODEL_DIR="./public/models/nsfw"
# Combined-score cutoff: reject if P(Porn) + P(Hentai) + 0.5*P(Sexy) >= threshold.
# Per-class hard gates (P(Porn)>=0.30, P(Hentai)>=0.30, P(Sexy)>=0.55) also apply.
NSFW_THRESHOLD=0.45
