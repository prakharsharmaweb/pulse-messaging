{
  "name": "realtime-messaging",
  "version": "1.0.0",
  "private": true,
  "description": "Production-oriented real-time messaging module (Next.js + Socket.IO + Prisma + PostgreSQL)",
  "scripts": {
    "predev": "prisma generate",
    "dev": "node scripts/dev-server.mjs",
    "build": "prisma generate && next build && node scripts/build-server.mjs",
    "start": "cross-env NODE_ENV=production node .server/server.cjs",
    "typecheck": "tsc --noEmit",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "setup:models": "tsx scripts/download-nsfw-model.ts",
    "lint": "next lint"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@tensorflow/tfjs": "^4.22.0",
    "@types/pngjs": "^6.0.5",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cookie": "^0.6.0",
    "date-fns": "^3.6.0",
    "dotenv": "^17.4.2",
    "file-type": "^19.6.0",
    "framer-motion": "^13.2.0",
    "jose": "^5.9.6",
    "jpeg-js": "^0.4.4",
    "nanoid": "^5.0.9",
    "next": "14.2.15",
    "nsfwjs": "^4.2.1",
    "pngjs": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie": "^0.6.0",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "puppeteer-core": "^25.10.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
